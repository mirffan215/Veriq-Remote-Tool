<Project Sdk="Microsoft.NET.Sdk">
  <!-- Editions: `-p:Edition=UAT` (see editions\README.md) imports editions\UAT\edition.props: name, data folder, icon, relay defaults, extra code. No Edition = the plain default. -->
  <PropertyGroup>
    <EditionDir Condition="'$(Edition)' != ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\editions\$(Edition)\'))</EditionDir>
  </PropertyGroup>
  <Import Project="$(EditionDir)edition.props" Condition="'$(EditionDir)' != '' And Exists('$(EditionDir)edition.props')" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>RemoteTool.App</RootNamespace>
    <AssemblyName>RemoteTool</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en;ar</SatelliteResourceLanguages>
    <ApplicationIcon Condition="'$(EditionIcon)' == ''">Assets\RemoteTool.ico</ApplicationIcon>
    <ApplicationIcon Condition="'$(EditionIcon)' != ''">$(EditionIcon)</ApplicationIcon>
    <StartupObject>RemoteTool.App.Program</StartupObject>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Product Condition="'$(Product)' == ''">RemoteTool</Product>
    <Company>In-house IT</Company>
  </PropertyGroup>
  <!--
    Company defaults built into the exe so users never configure a relay. Supply at build time (all optional), e.g.
        dotnet build -p:DefaultRelayAddress=relay.corp.example:443 -p:DefaultRelayFingerprint=AABB... -p:DefaultRelayKey=...
    or through the environment variables RT_DEFAULT_RELAY / RT_DEFAULT_RELAY_FP / RT_DEFAULT_RELAY_KEY (CI secrets).
    Values are embedded as JSON strings. The access key inside an exe can be extracted: it only keeps outsiders off your relay.
  -->
  <PropertyGroup>
    <DefaultRelayAddress Condition="'$(DefaultRelayAddress)' == ''">$(RT_DEFAULT_RELAY)</DefaultRelayAddress>
    <DefaultRelayFingerprint Condition="'$(DefaultRelayFingerprint)' == ''">$(RT_DEFAULT_RELAY_FP)</DefaultRelayFingerprint>
    <DefaultRelayKey Condition="'$(DefaultRelayKey)' == ''">$(RT_DEFAULT_RELAY_KEY)</DefaultRelayKey>
  </PropertyGroup>
  <Target Name="GenerateEmbeddedDefaults" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <_DefaultsFile>$(IntermediateOutputPath)defaults.json</_DefaultsFile>
      <!-- JSON-escape (backslash, quote); MSBuild has no UTF8 property function, so values are embedded as plain escaped JSON strings -->
      <_Relay>$(DefaultRelayAddress.Replace('\', '\\').Replace('"', '\"').Replace(';', '%3B'))</_Relay>
      <_Fp>$(DefaultRelayFingerprint.Replace('\', '\\').Replace('"', '\"').Replace(';', '%3B'))</_Fp>
      <_Key>$(DefaultRelayKey.Replace('\', '\\').Replace('"', '\"').Replace(';', '%3B'))</_Key>
    </PropertyGroup>
    <WriteLinesToFile File="$(_DefaultsFile)" Overwrite="true" Lines="{&quot;relay&quot;:&quot;$(_Relay)&quot;,&quot;fingerprint&quot;:&quot;$(_Fp)&quot;,&quot;accessKey&quot;:&quot;$(_Key)&quot;}" />
    <ItemGroup>
      <EmbeddedResource Include="$(_DefaultsFile)" LogicalName="RemoteTool.defaults.json" />
    </ItemGroup>
  </Target>

  <Target Name="GenerateEmbeddedEdition" BeforeTargets="AssignTargetPaths" Condition="'$(Edition)' != ''">
    <PropertyGroup>
      <_EditionFile>$(IntermediateOutputPath)edition.json</_EditionFile>
      <_EdId>$(Edition.Replace('\', '\\').Replace('"', '\"'))</_EdId>
      <_EdName>$(EditionDisplayName.Replace('\', '\\').Replace('"', '\"').Replace(';', '%3B'))</_EdName>
      <_EdFolder>$(EditionDataFolder.Replace('\', '\\').Replace('"', '\"'))</_EdFolder>
      <_EdBanner>$(EditionBanner.Replace('\', '\\').Replace('"', '\"').Replace(';', '%3B'))</_EdBanner>
    </PropertyGroup>
    <WriteLinesToFile File="$(_EditionFile)" Overwrite="true" Lines="{&quot;id&quot;:&quot;$(_EdId)&quot;,&quot;displayName&quot;:&quot;$(_EdName)&quot;,&quot;dataFolder&quot;:&quot;$(_EdFolder)&quot;,&quot;banner&quot;:&quot;$(_EdBanner)&quot;}" />
    <ItemGroup>
      <EmbeddedResource Include="$(_EditionFile)" LogicalName="RemoteTool.edition.json" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- The WPF SDK omits System.IO from implicit usings (Path clashes with System.Windows.Shapes.Path); this project never imports Shapes. -->
    <Using Include="System.IO" />
    <Resource Condition="'$(EditionIcon)' == ''" Include="Assets\RemoteTool.ico" />
    <Resource Condition="'$(EditionIcon)' != ''" Include="$(EditionIcon)" Link="Assets\RemoteTool.ico" />   <!-- windows load /Assets/RemoteTool.ico: an edition swaps the file behind that name -->
    <!-- Code that exists only in one edition: put .cs files in editions\<Edition>\Customization\ (hook: EditionCustomization.OnStartup) -->
    <Compile Condition="'$(EditionDir)' != ''" Include="$(EditionDir)Customization\**\*.cs" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <ProjectReference Include="../RemoteTool.Core/RemoteTool.Core.csproj" />
    <ProjectReference Include="../RemoteTool.Capture/RemoteTool.Capture.csproj" />
    <ProjectReference Include="../RemoteTool.Input/RemoteTool.Input.csproj" />
    <ProjectReference Include="../RemoteTool.Video/RemoteTool.Video.csproj" />
    <ProjectReference Include="../RemoteTool.Service/RemoteTool.Service.csproj" />
  </ItemGroup>
</Project>
