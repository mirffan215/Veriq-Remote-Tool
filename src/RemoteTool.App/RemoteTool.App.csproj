<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>RemoteTool.App</RootNamespace>
    <AssemblyName>RemoteTool</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en;ar</SatelliteResourceLanguages>
    <StartupObject>RemoteTool.App.Program</StartupObject>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Product>RemoteTool</Product>
    <Company>In-house IT</Company>
  </PropertyGroup>
  <ItemGroup>
    <!-- The WPF SDK omits System.IO from implicit usings (Path clashes with System.Windows.Shapes.Path); this project never imports Shapes. -->
    <Using Include="System.IO" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <ProjectReference Include="../RemoteTool.Core/RemoteTool.Core.csproj" />
    <ProjectReference Include="../RemoteTool.Capture/RemoteTool.Capture.csproj" />
    <ProjectReference Include="../RemoteTool.Input/RemoteTool.Input.csproj" />
    <ProjectReference Include="../RemoteTool.Video/RemoteTool.Video.csproj" />
    <ProjectReference Include="../RemoteTool.Service/RemoteTool.Service.csproj" />
  </ItemGroup>
</Project>
