<Window x:Class="RemoteTool.App.Windows.ServiceSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RemoteTool.App.Localization"
        Title="{loc:T Svc_Title}" Width="560" Height="740" MinHeight="560" WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,18,24,24">
      <Border BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
        <TextBlock Text="{loc:T Svc_Warning}" TextWrapping="Wrap" />
      </Border>
      <TextBlock x:Name="StatusText" Margin="0,12,0,0" FontWeight="SemiBold" />

      <CheckBox x:Name="EnabledBox" Content="{loc:T Svc_Enable}" Margin="0,14,0,0" />
      <CheckBox x:Name="ConsentBox" Content="{loc:T Svc_Consent}" IsChecked="True" />
      <CheckBox x:Name="LanBox" Content="{loc:T Svc_Lan}" />
      <CheckBox x:Name="RecordBox" Content="{loc:T Svc_Record}" />
      <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
        <TextBlock Text="{loc:T Svc_Retention}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox x:Name="RetentionBox" Width="70" Text="30" FlowDirection="LeftToRight" />
      </StackPanel>

      <TextBlock Text="{loc:T Display_Name}" Margin="0,12,0,2" Foreground="{DynamicResource MutedBrush}" />
      <TextBox x:Name="NameBox" MaxLength="64" />
      <TextBlock Text="{loc:T Relay_Address}" Margin="0,10,0,2" Foreground="{DynamicResource MutedBrush}" />
      <TextBox x:Name="RelayBox" FlowDirection="LeftToRight" />
      <TextBlock Text="{loc:T Relay_Key}" Margin="0,10,0,2" Foreground="{DynamicResource MutedBrush}" />
      <PasswordBox x:Name="KeyBox" FlowDirection="LeftToRight" />
      <TextBlock Text="{loc:T Relay_Fingerprint}" Margin="0,10,0,2" Foreground="{DynamicResource MutedBrush}" />
      <TextBox x:Name="FingerprintBox" FontFamily="Consolas" FlowDirection="LeftToRight" />

      <TextBlock Text="{loc:T Svc_Password}" Margin="0,12,0,2" Foreground="{DynamicResource MutedBrush}" />
      <PasswordBox x:Name="Pw1Box" FlowDirection="LeftToRight" />
      <TextBlock Text="{loc:T Svc_Password2}" Margin="0,8,0,2" Foreground="{DynamicResource MutedBrush}" />
      <PasswordBox x:Name="Pw2Box" FlowDirection="LeftToRight" />

      <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
        <Button x:Name="ApplyButton" Content="{loc:T Svc_Apply}" Style="{StaticResource PrimaryButton}" Click="Apply_Click" />
        <Button Content="{loc:T Svc_Uninstall}" Click="Uninstall_Click" />
      </StackPanel>
      <CheckBox x:Name="PurgeBox" Content="{loc:T Svc_Purge}" Margin="0,8,0,0" />
      <TextBlock x:Name="ResultText" Margin="0,10,0,0" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Window>
