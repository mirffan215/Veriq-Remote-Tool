<Window Icon="/Assets/RemoteTool.ico" x:Class="RemoteTool.App.Windows.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RemoteTool.App.Localization"
        Title="{loc:T Consent_Title}" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True">
  <StackPanel Margin="24" MinWidth="380">
    <TextBlock x:Name="Headline" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="SourceText" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
    <TextBlock x:Name="RelayNote" Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Text="{loc:T Consent_Relay_Note}" />
    <TextBlock x:Name="CodeNote" Margin="0,10,0,0" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
    <TextBlock x:Name="RecNote" Margin="0,10,0,0" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" Text="{loc:T Rec_Notice}" />
    <StackPanel Margin="0,16,0,0">
      <CheckBox x:Name="ControlBox" Content="{loc:T Perm_Control}" IsChecked="True" />
      <CheckBox x:Name="ClipboardBox" Content="{loc:T Perm_Clipboard}" IsChecked="True" />
      <CheckBox x:Name="FilesBox" Content="{loc:T Perm_Files}" IsChecked="True" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" FlowDirection="LeftToRight">
      <Button x:Name="AllowButton" Content="{loc:T Allow}" Style="{StaticResource PrimaryButton}" Click="Allow_Click" />
      <Button x:Name="DenyButton" Content="{loc:T Deny}" IsDefault="True" IsCancel="True" Margin="0" Click="Deny_Click" />
    </StackPanel>
  </StackPanel>
</Window>
