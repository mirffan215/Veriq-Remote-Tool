<Window x:Class="RemoteTool.App.Windows.BannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RemoteTool.App.Localization"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight" Background="#C62828" Title="RemoteTool">
  <StackPanel Orientation="Horizontal" Margin="16,8">
    <TextBlock x:Name="Message" Foreground="White" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
    <TextBlock x:Name="Hint" Foreground="#FFE0E0" FontSize="11" VerticalAlignment="Center" Margin="14,0,14,0" Text="{loc:T Banner_Hotkey}" />
    <Button x:Name="SendFileButton" Content="{loc:T Banner_SendFile}" Visibility="Collapsed" Click="SendFile_Click" />
    <Button x:Name="DisconnectButton" Content="{loc:T Banner_Disconnect}" Margin="0" Click="Disconnect_Click" />
  </StackPanel>
</Window>
