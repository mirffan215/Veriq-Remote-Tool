<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    RemoteTool MSI.
      * per-machine, 64-bit, installs to %ProgramFiles%\RemoteTool (admin-writable only: a SYSTEM service may later run from here)
      * requires Windows 10 1809 / Server 2019 or newer (TLS 1.3 preferred, TLS 1.2 AEAD fallback)
      * optional first-run defaults for ALL users, set with msiexec properties:  RELAY_ADDRESS  RELAY_FINGERPRINT
        -> machine environment variables REMOTETOOL_RELAY / REMOTETOOL_RELAY_FP (the relay ACCESS KEY is deliberately NOT an MSI property:
           properties end up in logs and the installer cache; deliver the key from your secret store, see docs/INTUNE.md)
      * does not enable unattended access: that is a separate, explicit, elevated step (RemoteTool.exe "configure-service" switch ...)
      * uninstall removes the unattended service and its firewall rules if present; configuration, audit logs and recordings in
        %ProgramData%\RemoteTool are KEPT (retention policy decides)
  -->
  <Package Name="RemoteTool" Manufacturer="In-house IT" Version="$(ProductVersion)"
           UpgradeCode="6B1D1B52-8C3B-4F0A-9D61-3C7A5E0A1F24" Scope="perMachine" Compressed="yes" InstallerVersion="500">
    <Icon Id="AppIcon" SourceFile="$(PackageIconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of RemoteTool is already installed." Schedule="afterInstallExecute" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Launch Condition="Installed OR (WindowsBuild &gt;= 17763)" Message="RemoteTool requires Windows 10 (version 1809) or newer, or Windows Server 2019 or newer." />

    <Property Id="ARPCOMMENTS" Value="Remote support tool - end-to-end encrypted, consent-based" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="RELAY_ADDRESS" Secure="yes" />
    <Property Id="RELAY_FINGERPRINT" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RemoteTool" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuDir" Name="RemoteTool" />
    </StandardDirectory>

    <!-- The single self-contained exe (from deploy\RemoteTool.Package). Unversioned-file rules do not apply: the version resource decides. -->
    <Component Id="MainExe" Directory="INSTALLFOLDER" Bitness="always64">
      <File Id="RemoteToolExe" Source="$(PackageDir)\RemoteTool.exe" KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="AppMenuDir" Bitness="always64">
      <Shortcut Id="AppShortcut" Name="RemoteTool" Description="Remote support tool" Target="[#RemoteToolExe]" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveAppMenuDir" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\RemoteTool\Installer" Name="Shortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- First-run defaults for every user of this PC; only written when the property was supplied on the command line. -->
    <Component Id="EnvRelayAddress" Directory="INSTALLFOLDER" Bitness="always64" Condition="RELAY_ADDRESS &lt;&gt; &quot;&quot;">
      <Environment Id="EnvRelayAddr" Name="REMOTETOOL_RELAY" Value="[RELAY_ADDRESS]" Action="set" Part="all" System="yes" Permanent="no" />
      <RegistryValue Root="HKLM" Key="Software\RemoteTool\Installer" Name="RelayAddressSet" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="EnvRelayFingerprint" Directory="INSTALLFOLDER" Bitness="always64" Condition="RELAY_FINGERPRINT &lt;&gt; &quot;&quot;">
      <Environment Id="EnvRelayFp" Name="REMOTETOOL_RELAY_FP" Value="[RELAY_FINGERPRINT]" Action="set" Part="all" System="yes" Permanent="no" />
      <RegistryValue Root="HKLM" Key="Software\RemoteTool\Installer" Name="RelayFingerprintSet" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="RemoteTool" Level="1" AllowAdvertise="no">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="EnvRelayAddress" />
      <ComponentRef Id="EnvRelayFingerprint" />
    </Feature>

    <!-- Uninstall (not upgrade): remove the unattended service + firewall rules if they exist. Return="ignore": nothing to do is not an error. -->
    <CustomAction Id="RemoveUnattendedService" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]RemoteTool.exe&quot; --service-control remove"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RemoveUnattendedService" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- Standard "choose folder" wizard with a license page. Edit License.rtf to your organisation's terms. -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

  </Package>
</Wix>
