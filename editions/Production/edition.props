<Project>
  <!-- PRODUCTION edition: what real users run. Keep changes here minimal and reviewed. -->
  <PropertyGroup>
    <EditionDisplayName>Veriq Remote Tool</EditionDisplayName>
    <EditionDataFolder>VeriqRemoteTool</EditionDataFolder>
    <EditionBanner></EditionBanner>
    <EditionIcon>$(MSBuildThisFileDirectory)RemoteTool.ico</EditionIcon>
    <EditionExeName>ToolVeriq.exe</EditionExeName>
    <Product>$(EditionDisplayName)</Product>
    <DefaultRelayAddress Condition="'$(DefaultRelayAddress)' == ''">$(RT_PROD_RELAY)</DefaultRelayAddress>
    <DefaultRelayFingerprint Condition="'$(DefaultRelayFingerprint)' == ''">$(RT_PROD_RELAY_FP)</DefaultRelayFingerprint>
    <DefaultRelayKey Condition="'$(DefaultRelayKey)' == ''">$(RT_PROD_RELAY_KEY)</DefaultRelayKey>
  </PropertyGroup>
</Project>
