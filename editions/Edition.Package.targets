<Project>
  <!--
    Shared by editions\Enterprise, editions\Production and editions\UAT. Building one of those projects publishes RemoteTool.App for that edition as ONE self-contained exe:
        artifacts\<Edition>\<EditionExeName>          e.g. artifacts\UAT\ToolVeriq-UAT.exe
        artifacts\<Edition>\<EditionExeName>.sha256
        artifacts\<Edition>\README.txt
        artifacts\<Edition>-<version>-win-x64.zip
    The source is shared (src\...). The edition only supplies identity (edition.props), an icon, relay defaults and optional extra code (Customization\).
    Command line:  dotnet build editions\UAT -c Release        Visual Studio: right-click the edition project -> Build.
    Overridable (tests): PackagedProject, PackageRid, PackageDir.
  -->
  <Import Project="$(MSBuildThisFileDirectory)$(Edition)\edition.props" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</RepoRoot>
    <PackageDotnet>$(DOTNET_HOST_PATH)</PackageDotnet>
    <PackageDotnet Condition="'$(PackageDotnet)' == ''">dotnet</PackageDotnet>
    <PackagedProject Condition="'$(PackagedProject)' == ''">$(RepoRoot)src\RemoteTool.App\RemoteTool.App.csproj</PackagedProject>
    <PackageRid Condition="'$(PackageRid)' == ''">win-x64</PackageRid>
    <PackageDir Condition="'$(PackageDir)' == ''">$(RepoRoot)artifacts\$(Edition)</PackageDir>
    <PackageZip Condition="'$(PackageZip)' == ''">$(RepoRoot)artifacts\$(Edition)-$(Version)-$(PackageRid).zip</PackageZip>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Marker.cs" />
  </ItemGroup>

  <Target Name="PackageEditionExe" AfterTargets="Build">
    <Message Importance="high" Text="Packaging edition '$(Edition)' ($(EditionDisplayName)) for $(PackageRid) ..." />
    <RemoveDir Directories="$(PackageDir)" />
    <RemoveDir Directories="$([System.IO.Path]::GetDirectoryName($(PackagedProject)))\obj;$([System.IO.Path]::GetDirectoryName($(PackagedProject)))\bin" />

    <!-- Same flags as scripts\publish-app.ps1, plus the edition. The app obj and bin folders are cleared first because editions share them, so another edition output is never reused. The relay defaults reach the child build through the environment (RT_<EDITION>_RELAY ...). -->
    <Exec Command="&quot;$(PackageDotnet)&quot; publish &quot;$(PackagedProject)&quot; -c Release -r $(PackageRid) --self-contained true -p:Edition=$(Edition) -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:EnableCompressionInSingleFile=true -p:DebugType=none -p:DebugSymbols=false -o &quot;$(PackageDir)&quot;"
          StandardOutputImportance="low" />

    <ItemGroup>
      <_Leftovers Include="$(PackageDir)\**\*.pdb" />
      <_Leftovers Include="$(PackageDir)\web.config" />
    </ItemGroup>
    <Delete Files="@(_Leftovers)" />

    <Error Condition="!Exists('$(PackageDir)\RemoteTool.exe')" Text="Publish did not produce $(PackageDir)\RemoteTool.exe" />
    <!-- The assembly is always RemoteTool.exe; the edition gets its own file name so editions are told apart in Explorer and Task Manager. -->
    <Move SourceFiles="$(PackageDir)\RemoteTool.exe" DestinationFiles="$(PackageDir)\$(EditionExeName)" />

    <GetFileHash Files="$(PackageDir)\$(EditionExeName)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_ExeHash" />
    </GetFileHash>
    <PropertyGroup>
      <_Sha>%(_ExeHash.FileHash)</_Sha>
    </PropertyGroup>
    <WriteLinesToFile File="$(PackageDir)\$(EditionExeName).sha256" Lines="$(_Sha)  $(EditionExeName)" Overwrite="true" />

    <ItemGroup>
      <_Readme Include="$(EditionDisplayName) $(EditionBanner) $(Version) - portable package (edition: $(Edition))" />
      <_Readme Include="1. Copy $(EditionExeName) to the PC and double-click it. No installer, no .NET needed." />
      <_Readme Include="2. Settings and logs live in %AppData%\$(EditionDataFolder) (or a data folder beside the exe if an empty file named portable.flag is next to it)." />
      <_Readme Include="3. Verify: certutil -hashfile $(EditionExeName) SHA256   must equal the value in $(EditionExeName).sha256" />
      <_Readme Include="4. Windows 10 (1809) / Server 2019 or newer. Unsigned builds trigger SmartScreen: sign the exe first (scripts\sign-app.ps1)." />
    </ItemGroup>
    <WriteLinesToFile File="$(PackageDir)\README.txt" Lines="@(_Readme)" Overwrite="true" />

    <Delete Files="$(PackageZip)" />
    <ZipDirectory SourceDirectory="$(PackageDir)" DestinationFile="$(PackageZip)" />

    <Message Importance="high" Text="----------------------------------------------------------------" />
    <Message Importance="high" Text="  Edition         : $(Edition)" />
    <Message Importance="high" Text="  Single-file exe : $(PackageDir)\$(EditionExeName)" />
    <Message Importance="high" Text="  SHA-256         : $(_Sha)" />
    <Message Importance="high" Text="  Zip package     : $(PackageZip)" />
    <Message Importance="high" Text="----------------------------------------------------------------" />
  </Target>
</Project>
